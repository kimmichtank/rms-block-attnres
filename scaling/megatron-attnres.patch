new file mode 100644
--- /dev/null
+++ b/megatron/core/transformer/attention_residuals.py
@@ -0,0 +1,256 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+# Adapted from Smu-Tan/Megatron-LM acd397827e4629abbd8bc8e5372292f4951fe5a1.
+# See examples/attention_residuals/README.md for provenance and changes.
+"""Full, Block and per-write RMS Block Attention Residuals."""
+
+import math
+from dataclasses import dataclass, field
+
+import torch
+from torch import Tensor, nn
+from torch.nn import functional as F
+
+
+def rms_write(value: Tensor, eps: float) -> Tensor:
+    """Normalize each token across hidden channels, without affine or centering."""
+    x = value.float()
+    return (x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)).to(value.dtype)
+
+
+def _full_attn_res_compute(values, query, weight, eps):
+    """Compute the learned depth read using the model activation dtype."""
+    reference = values[0]
+    query = query.to(dtype=reference.dtype)
+    weight = weight.to(dtype=reference.dtype)
+
+    logits = []
+    for value in values:
+        variance = value.pow(2).mean(dim=-1, keepdim=True)
+        key = value * torch.rsqrt(variance + eps) * weight
+        logits.append(torch.einsum('h,sbh->sb', query, key))
+
+    depth_weights = torch.softmax(torch.stack(logits, dim=0), dim=0).to(reference.dtype)
+    output = torch.zeros_like(reference)
+    for depth, value in enumerate(values):
+        output = output + depth_weights[depth].unsqueeze(-1) * value
+    return output
+
+
+class _FullAttnResCheckpointed(torch.autograd.Function):
+    """Recompute a Full AttnRes read during backward.
+
+    Full history reuses the embedding and earlier writes in many reads. Passing
+    the query, key weight, and every history tensor explicitly through one
+    autograd function avoids the unstable generic checkpoint path observed on
+    PPU while preserving the same forward formula.
+    """
+
+    @staticmethod
+    def forward(ctx, query, weight, eps, *values):
+        ctx.eps = eps
+        ctx.save_for_backward(query, weight, *values)
+        with torch.no_grad():
+            return _full_attn_res_compute(values, query, weight, eps)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        query, weight, *values = ctx.saved_tensors
+        query_recompute = query.detach().requires_grad_(True)
+        weight_recompute = weight.detach().requires_grad_(True)
+        values_recompute = [value.detach().requires_grad_(True) for value in values]
+
+        with torch.enable_grad():
+            output = _full_attn_res_compute(
+                values_recompute, query_recompute, weight_recompute, ctx.eps
+            )
+        grads = torch.autograd.grad(
+            output,
+            (query_recompute, weight_recompute, *values_recompute),
+            grad_output,
+            allow_unused=True,
+        )
+        query_grad, weight_grad, *value_grads = grads
+        if query_grad is None:
+            query_grad = torch.zeros_like(query)
+        if weight_grad is None:
+            weight_grad = torch.zeros_like(weight)
+        value_grads = [
+            torch.zeros_like(value) if grad is None else grad
+            for value, grad in zip(values, value_grads)
+        ]
+        return query_grad, weight_grad, None, *value_grads
+
+
+@dataclass
+class AttnResState:
+    """Per-forward history; embeddings stay separate from sublayer blocks.
+
+    In rms_block mode the pending sum stays raw. Only a completed block is
+    replaced by the sum of its individually normalized writes. Histories are
+    never mutated in-place, and values() returns an immutable snapshot.
+    """
+
+    embedding: Tensor
+    mode: str = 'full'
+    block_size: int = 4
+    eps: float = 1e-6
+    completed: list[Tensor] = field(default_factory=list)
+    pending: list[Tensor] = field(default_factory=list)
+
+    def __post_init__(self):
+        if self.mode not in ('full', 'block', 'rms_block'):
+            raise ValueError(f'Unknown Attention Residual mode: {self.mode}')
+        if self.block_size < 1 or self.eps <= 0:
+            raise ValueError('block_size and eps must be positive')
+
+    def append(self, value: Tensor):
+        if self.mode == 'full':
+            self.completed.append(value)
+            return
+        self.pending.append(value)
+        if len(self.pending) == self.block_size:
+            writes = self.pending
+            if self.mode == 'rms_block':
+                writes = [rms_write(v, self.eps) for v in writes]
+            self.completed.append(sum(writes))
+            self.pending = []
+
+    def values(self) -> tuple[Tensor, ...]:
+        partial = (sum(self.pending),) if self.pending else ()
+        return (self.embedding, *self.completed, *partial)
+
+
+class FullAttnRes(nn.Module):
+    """The same learned depth read is shared by all three history policies.
+
+    Keys use affine RMSNorm; values stay unchanged. The learned query starts at
+    zero (uniform weights).
+    """
+
+    def __init__(self, hidden_size, eps=1e-6, implementation='torch'):
+        super().__init__()
+        if hidden_size < 1 or eps <= 0:
+            raise ValueError('hidden_size and eps must be positive')
+        if implementation not in ('torch', 'checkpointed'):
+            raise ValueError('implementation must be torch or checkpointed')
+        self.hidden_size = hidden_size
+        self.eps = eps
+        self.implementation = implementation
+        self.query = nn.Parameter(torch.zeros(hidden_size))
+        self.weight = nn.Parameter(torch.ones(hidden_size))
+
+    def _compute(self, *values):
+        return _full_attn_res_compute(values, self.query, self.weight, self.eps)
+
+    def forward(self, values):
+        values = tuple(values)
+        if not values or values[0].ndim != 3 or values[0].shape[-1] != self.hidden_size:
+            raise ValueError('Expected nonempty [sequence, batch, hidden] sources')
+        if any(v.shape != values[0].shape for v in values):
+            raise ValueError('All sources must have the same shape')
+        if self.implementation == 'checkpointed' and torch.is_grad_enabled():
+            return _FullAttnResCheckpointed.apply(self.query, self.weight, self.eps, *values)
+        return self._compute(*values)
+
+
+def build_attn_res(config):
+    """Build a replicated learned read, registered before optimizer construction."""
+    module = FullAttnRes(
+        config.hidden_size,
+        config.attention_residual_key_epsilon,
+        config.attention_residual_implementation,
+    )
+    # Sequence-sharded reads have partial parameter gradients across TP ranks.
+    for param in module.parameters():
+        param.sequence_parallel = config.sequence_parallel
+    return module
+
+
+def validate_attn_res_config(config):
+    """Fail early for execution paths that do not carry full depth history."""
+    if config.attention_residual_type not in ('none', 'full', 'block', 'rms_block'):
+        raise ValueError('Unknown attention_residual_type')
+    if config.attention_residual_type == 'none':
+        return
+    if config.attention_residual_block_size < 1:
+        raise ValueError('attention_residual_block_size must be positive')
+    epsilons = (config.attention_residual_key_epsilon, config.attention_residual_write_epsilon)
+    if any(not math.isfinite(eps) or eps <= 0 for eps in epsilons):
+        raise ValueError('Attention Residual epsilons must be finite and positive')
+    # Start with the dense, ordinary execution path. Unsupported combinations
+    # must not silently fall back to ordinary residual connections.
+    requirements = {
+        'pipeline_model_parallel_size': 1,
+        'context_parallel_size': 1,
+        'virtual_pipeline_model_parallel_size': None,
+        'num_moe_experts': None,
+        'recompute_granularity': None,
+        'cpu_offloading': False,
+        'fp32_residual_connection': False,
+        'apply_residual_connection_post_layernorm': False,
+        'fused_residual_rmsnorm': False,
+        'enable_mhc_connections': False,
+        'fp8': None,
+        'fp4': None,
+        'cuda_graph_impl': 'none',
+        'inference_fuse_tp_communication': False,
+        'mtp_num_layers': None,
+    }
+    for name, expected in requirements.items():
+        if getattr(config, name, expected) != expected:
+            raise ValueError(f'Attention Residuals currently requires {name}={expected!r}')
+    if (
+        getattr(config, 'sequence_parallel', False)
+        and getattr(config, 'tensor_model_parallel_size', 1) == 1
+    ):
+        raise ValueError('Sequence parallel requires TP > 1')
+    if getattr(config, 'tensor_model_parallel_size', 1) > 1:
+        if getattr(config, 'hidden_dropout', 0) or getattr(config, 'attention_dropout', 0):
+            raise ValueError('Attention Residual TP currently requires zero dropout')
+    if config.attention_residual_type == 'rms_block':
+        if 2 * config.num_layers % config.attention_residual_block_size:
+            raise ValueError('RMS Block requires complete blocks, matching our existing trainer')
+
+
+def forward_attn_res_layer(layer, hidden_states, attention_mask=None, **kwargs):
+    """Reuse Megatron attention and dense MLP, replacing only residual routing."""
+    from megatron.core.transformer.identity_op import IdentityOp
+
+    state = kwargs.pop('attn_res_state', None)
+    if state is None:
+        raise RuntimeError('Attention Residual layer requires per-forward history')
+    if not isinstance(layer.cross_attention, IdentityOp):
+        raise NotImplementedError('Attention Residuals supports decoder-only layers')
+    if kwargs.get('inference_context') is not None or kwargs.get('inference_params') is not None:
+        raise NotImplementedError('Cached inference is not supported; use full-sequence forward')
+    if kwargs.get('context') is not None:
+        raise NotImplementedError('Cross-attention is not supported')
+
+    def write(output_with_bias):
+        output, bias = output_with_bias
+        if bias is not None:
+            output = output + bias
+        output = F.dropout(output, p=layer.hidden_dropout, training=layer.training)
+        state.append(output)
+        return output
+
+    attention_keys = (
+        'rotary_pos_emb',
+        'rotary_pos_cos',
+        'rotary_pos_sin',
+        'rotary_pos_cos_sin',
+        'attention_bias',
+        'packed_seq_params',
+        'sequence_len_offset',
+    )
+    attention_input = layer.input_layernorm(layer.attn_res(state.values()))
+    write(
+        layer.self_attention(
+            attention_input,
+            attention_mask=attention_mask,
+            **{key: kwargs[key] for key in attention_keys if key in kwargs},
+        )
+    )
+    mlp_input = layer.pre_mlp_layernorm(layer.mlp_attn_res(state.values()))
+    output = write(layer.mlp(mlp_input))
+    return output, kwargs.get('context')
