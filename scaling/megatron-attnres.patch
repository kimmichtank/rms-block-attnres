--- a/megatron/core/tensor_parallel/layers.py
+++ b/megatron/core/tensor_parallel/layers.py
@@ -654,6 +654,27 @@ def _wgrad_gemm(out, grad_output, total_input):
     return out
 
 
+def _attnres_chunked_tied_wgrad(weight, grad_output, total_input):
+    """Compute the Full AttnRes tied-vocabulary wgrad in row chunks.
+
+    The PPU backend has produced sporadic corrupt elements for the single
+    [local_vocab, hidden] GEMM under Full AttnRes memory pressure. Row chunks
+    preserve the same contraction while avoiding that large kernel shape.
+    """
+    chunk_rows = int(os.environ.get('ATTNRES_TIED_WGRAD_CHUNK_ROWS', '4096'))
+    if chunk_rows < 1:
+        raise ValueError('ATTNRES_TIED_WGRAD_CHUNK_ROWS must be positive')
+    grad_weight = torch.empty_like(weight)
+    for start in range(0, grad_output.shape[-1], chunk_rows):
+        end = min(start + chunk_rows, grad_output.shape[-1])
+        torch.matmul(
+            grad_output[:, start:end].t(),
+            total_input,
+            out=grad_weight[start:end],
+        )
+    return grad_weight
+
